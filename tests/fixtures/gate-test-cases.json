    "input": {
      "toolCall": { "server": "gitnexus", "tool": "query", "args": {} },
      "spec": { "allowed_tools": ["mcp.gitnexus.*"] }
    },
    "expected": { "gate": "policy", "allowed": true }
  },
  {
    "id": "policy-tool-denied",
    "input": {
