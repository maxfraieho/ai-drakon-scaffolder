# AI-DRAKON environment variables
# Copy to .env and fill in real values

VITE_WORKER_URL=https://drakon-mcp-worker.maxfraieho.workers.dev

# MCP API key (from Cloudflare Worker Dashboard -> Settings -> Variables and Secrets)
DRAKON_MCP_API_KEY=your-mcp-api-key-here

# OpenDesign (local design server — http://192.168.3.184:7459)
VITE_OPENDESIGN_URL=http://192.168.3.184:7459
VITE_OPENDESIGN_TOKEN=your-opendesign-token-here

# Cloudflare
CF_ACCOUNT_ID=your-account-id
