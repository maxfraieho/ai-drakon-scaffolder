{
  "name": "SlotRouter — score_candidate(candidate, health, task_type)",
  "access": "public",
  "params": [
    "candidate: ProxyCandidate",
    "health: BackendHealth",
    "task_type: str | None"
  ],
  "items": {
    "n1": {
      "type": "input",
      "content": "candidate, health, task_type, slot_id",
      "one": "n2"
    },
    "n2": {
      "type": "action",
      "content": "capability_score = 1.0 if \"chat\" in capabilities else 0.0\n+ 0.2 if \"streaming\" in capabilities",
      "one": "n3"
    },
    "n3": {
      "type": "question",
      "content": "health.state?",
      "one": "n3ok",
      "two": "n3bad"
    },
    "n3ok": {
      "type": "action",
      "content": "health_score = 1.0\n(healthy)",
      "one": "n4",
      "secondary": "state == healthy"
    },
    "n3bad": {
      "type": "question",
      "content": "state == degraded?",
      "one": "n3d",
      "two": "n3c"
    },
    "n3d": {
      "type": "action",
      "content": "health_score = 0.4",
      "one": "n4"
    },
    "n3c": {
      "type": "question",
      "content": "state ==\ncooling_down?",
      "one": "n3cd",
      "two": "n3u"
    },
    "n3cd": {
      "type": "action",
      "content": "health_score = -2.0",
      "one": "n4"
    },
    "n3u": {
      "type": "action",
      "content": "health_score = -4.0\n(unavailable)",
      "one": "n4"
    },
    "n4": {
      "type": "action",
      "content": "specialization_score = 1.0\nif task_type in candidate.specializations\nelse 0.0",
      "one": "n5"
    },
    "n5": {
      "type": "question",
      "content": "health.latency_ms_p50 > 0?",
      "one": "n5a",
      "two": "n5b"
    },
    "n5a": {
      "type": "action",
      "content": "latency_bonus = max(0, 1000 - p50) / 1000",
      "one": "n6"
    },
    "n5b": {
      "type": "action",
      "content": "latency_bonus = 0.0",
      "one": "n6"
    },
    "n6": {
      "type": "question",
      "content": "ROUTER_SMART_ENABLED\n== \"1\" and analysis?",
      "one": "n6a",
      "two": "n6b"
    },
    "n6a": {
      "type": "action",
      "content": "analysis_bonus = calc_analysis_bonus(slot_id, analysis)",
      "one": "n7"
    },
    "n6b": {
      "type": "action",
      "content": "analysis_bonus = 0.0",
      "one": "n7"
    },
    "n7": {
      "type": "output",
      "content": "score = capability*100 + health*50\n+ specialization*40 + analysis*25\n+ latency*10 + weight*5",
      "one": "nEnd"
    },
    "nEnd": {
      "type": "end",
      "content": "return score: float"
    }
  }
}