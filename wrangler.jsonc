{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drakon-mcp-worker",
  "main": "cloudflare-worker/worker-mcp-drakon.js",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MINIO_ENDPOINT": "",
    "MINIO_BUCKET": "",
    "MINIO_ACCESS_KEY": "",
    "MINIO_SECRET_KEY": "",
    "MINIO_USE_SSL": "true"
  },
  // Secrets встановлюються через: wrangler secret put JWT_SECRET
  // Secret: wrangler secret put GITHUB_TOKEN
  // або через Cloudflare Workers Dashboard → Settings → Variables and Secrets
}
